APP_NAME="Chatbot API"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database configuration (PostgreSQL + asyncpg)
DATABASE_URL="postgresql+asyncpg://api:api@localhost:5432/api_db"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis configuration
REDIS_URL="redis://localhost:6379/0"

# CORS configuration (JSON array string)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
